<Window x:Class="SIM_TIA_DeviceAlarmgenerator.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SIM_TIA_DeviceAlarmgenerator.View"
        xmlns:localVM="clr-namespace:SIM_TIA_DeviceAlarmgenerator.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <localVM:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dateiauswahl -->
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnPickFile" Command="{Binding PickFileCommand}" Padding="12,6">Datei wählen…</Button>
            <TextBox x:Name="TxtFilePath" Text="{Binding FilePath}" Width="600" IsReadOnly="True" />
        </StackPanel>

        <!-- Sheet + Bereich -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock>Sheet-Name</TextBlock>
                <TextBox x:Name="TxtSheet"  Width="160" Text="{Binding SheetName}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Startzeile (1-basiert)</TextBlock>
                <TextBox x:Name="TxtStartRow" Width="120" Text="{Binding StartRow}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Endzeile (inkl.)</TextBlock>
                <TextBox x:Name="TxtEndRow" Width="120"  Text="{Binding EndRow}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Startspalte (1=A)</TextBlock>
                <TextBox x:Name="TxtStartCol" Width="120"  Text="{Binding StartCol}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Endspalte (inkl.)</TextBlock>
                <TextBox x:Name="TxtEndCol" Width="120"  Text="{Binding EndCol}"/>
            </StackPanel>
            <Button x:Name="BtnRead" Command="{Binding ReadDataCommand}" Padding="12,6" Margin="8,18,0,0">Bereich lesen</Button>
        </StackPanel>

        <!-- Hinweis -->
        <TextBlock Grid.Row="2" Margin="0,8,0,8" Foreground="Gray">
            Ausgabe: zeilenweise in einer Tabelle. Leere Zellen werden als "" angezeigt.
        </TextBlock>

        <!-- Ergebnis -->
        <DataGrid Grid.Row="3" x:Name="GridResult" ItemsSource="{Binding Data}" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>
